# 工作区私有数据（由本地工具维护，不属项目内容）
.workbuddy/

# 管线目录：体量大（291M，含 npz / csv.gz 大数据文件），不随本仓库版本管理
iGEM-platform-main/

# 导出包解开的目录：每个文件都能由同目录的 .tar.gz 逐字节解开重现，而那份归档与它的
# 校验和是入库的，收到时的原始凭据因此仍在版本管理之内。解开是为了装载，装载完就没有
# 必要跟着仓库走两遍。
resouces/pg_export_20261011/

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
logs
*.log

# 环境变量（service/.env 内含数据库连接串，不得入库）
.env

# 本地回退数据库（由 local/fixture_local.sql 按需构建）
local/*.sqlite3
local/*.sqlite3-journal

# 系统与编辑器
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# Excel 打开工作簿时生成的锁文件
~$*

# 走查脚本的临时编译产物
app/.verify-cache/

# 静态导出：由 service/scripts/export_static.py 从数据库生成，这里有意入库。
# 项目已进入收尾，这份导出不再变化，入库是为了让队友 clone 之后既不必连数据库、也不必
# 重新导出就能把页面跑起来（npm run dev 直接读 public/data）。内容来自本机 PostgreSQL，
# 496 条构造，manifest.json 与 health.json 的 source_backend 均记 postgres。
# 导出会整体替换 public/data/：真重新导过一次，就得连同新文件一起提交，否则仓库里那份
# 会静默变旧，而它看起来与新的没有区别。
