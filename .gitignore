# 工作区私有数据（由本地工具维护，不属项目内容）
.workbuddy/

# 管线目录：体量大（291M，含 npz / csv.gz 大数据文件），不随本仓库版本管理
iGEM-platform-main/

# 导出包解开的目录：每个文件都能由同目录的 .tar.gz 逐字节解开重现，而那份归档与它的
# 校验和是入库的，收到时的原始凭据因此仍在版本管理之内。解开是为了装载，装载完就没有
# 必要跟着仓库走两遍。
resouces/pg_export_20261011/

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
logs
*.log

# 环境变量（service/.env 内含数据库连接串，不得入库）
.env

# 本地回退数据库（由 local/fixture_local.sql 按需构建）
local/*.sqlite3
local/*.sqlite3-journal

# 系统与编辑器
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# Excel 打开工作簿时生成的锁文件
~$*

# 走查脚本的临时编译产物
app/.verify-cache/

# 静态导出：由 service/scripts/export_static.py 从数据库生成，不入库。
# 当前工作区里那份来自本机 PostgreSQL（496 条构造，manifest 的 source_backend 报 postgres）；
# 换一台机器要么照 app/DEPLOY.md 重新导一次，要么改用读服务的那条路径。
# 脚本默认拒绝从 SQLite 夹具导出——夹具导出的 source_backend 是 sqlite，界面上的样例数据提示据此出现。
app/public/data/
