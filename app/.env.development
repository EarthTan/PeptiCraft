# Settings for the development server. This file is committed.
#
# The structure store is a public R2 bucket that holds the predicted coordinates, and
# the address is the same one a production build uses. Development needs it here rather
# than in .env.production because Vite reads only the file for the mode it is running:
# `npm run dev` is the development mode and never looks at .env.production, so without
# this file the viewer has no bucket to read from and renders nothing.
VITE_STRUCTURE_BASE_URL=https://pub-e92779d3b73e46229f1118ce915547d4.r2.dev
