# PeptiCraft backend service — environment template.
#
# Copy to `.env` and fill in the password, or export the variables directly.

# --- database -----------------------------------------------------------------
# The database runs on a separate machine and is reached by its IP address, so
# there is no localhost default. On this network it is the Ubuntu workstation's
# Tailscale address.
IGEM_PG_HOST=100.69.116.8
IGEM_PG_PORT=5432
IGEM_PG_DB=igem_peptides
IGEM_PG_USER=igem
IGEM_PG_PASSWORD=change-me

# Alternatively supply a full libpq string and leave the parts above unset:
# IGEM_PG_DSN=host=100.69.116.8 port=5432 dbname=igem_peptides user=igem password=...

# A local Postgres also listens on 127.0.0.1 and does not carry the `igem` role, so a
# DSN pointing at localhost is rejected unless this is set — intended for a deliberate
# SSH tunnel only.
IGEM_PG_ALLOW_LOCALHOST=false

# --- local fallback ------------------------------------------------------------
# The remote instance is a workstation behind a tunnel and is not always reachable.
#   auto      probe Postgres once; if the probe fails, serve the bundled SQLite fixture
#             (two hand-made constructs) and say so on /api/health. Development default.
#   postgres  never fall back; a dead database must be visible. Use this in a deployment.
#   sqlite    never touch Postgres; serve the fixture. Use this in a test run.
IGEM_DB_BACKEND=auto

# Where the fixture database is written, and the SQL it is built from. Both default to
# service/local/; the database is generated on first use and is not committed.
# IGEM_SQLITE_PATH=local/pepticraft_local.sqlite3
# IGEM_SQLITE_FIXTURE=local/fixture_local.sql

# Per-query ceiling. peptide_enrichment holds 377 M rows in 130 GB and a planner
# mistake there should fail the request, not occupy a worker indefinitely.
STATEMENT_TIMEOUT_MS=60000
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=8

# --- http ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- analysis -----------------------------------------------------------------
# `template` renders deterministic prose from the real scores. `llm` is reserved for the
# later model-backed generator and is not implemented yet.
ANALYSIS_PROVIDER=template
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
